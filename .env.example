# ─── ai_browser .env ───────────────────────────────────────────────────
# Copy this file to .env and fill in the values you need.
#   cp .env.example .env
#
# All variables here are optional — the CLI falls back to defaults for
# each flag when the env var is unset.  CLI-provided flags always
# override .env values (that's Click's built-in envvar behaviour:
# explicit CLI args win over the environment default).
#
# Deliberately excluded from .env:
#   --register-password   (fresh per-run is safer; generate with
#                          openssl rand -base64 16 each invocation)
#   --authorized          (explicit per-run confirmation)
#   hostname              (positional argument, not an option)

# ─── Proxy ─────────────────────────────────────────────────────────────

AIBROWSER_PROXY_SERVER=http://127.0.0.1:8080

# ─── LLM ───────────────────────────────────────────────────────────────
# At minimum you need to set AIBROWSER_LLM_API_KEY (or its deprecated
# equivalent) plus AIBROWSER_LLM_MODEL for the agent explorer to work.

AIBROWSER_LLM_PROVIDER=anthropic
# AIBROWSER_LLM_MODEL=claude-sonnet-4-20250514
AIBROWSER_LLM_API_KEY=sk-ant-...
# AIBROWSER_LLM_BASE_URL=
AIBROWSER_LLM_MAX_TOKENS=4096

# Deprecated alias — use AIBROWSER_LLM_API_KEY instead
# AIBROWSER_ANTHROPIC_API_KEY=

# ─── Registration ──────────────────────────────────────────────────────

AIBROWSER_REGISTER_EMAIL=test+example@yourdomain.com

# ─── IMAP (email confirmation polling) ─────────────────────────────────

AIBROWSER_IMAP_HOST=imap.yourdomain.com
AIBROWSER_IMAP_PORT=993
AIBROWSER_IMAP_USERNAME=test@yourdomain.com
AIBROWSER_IMAP_PASSWORD=your-app-specific-password

# ─── Storage ───────────────────────────────────────────────────────────

# AIBROWSER_STORAGE_DIR=storage/browser_states

# ─── TLS ────────────────────────────────────────────────────────────────

# AIBROWSER_CA_CERT=
